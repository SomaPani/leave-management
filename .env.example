# Copy to .env, then start the database with `docker compose up -d`.
# docker-compose.yml reads the POSTGRES_* values; the app reads DATABASE_URL.

POSTGRES_USER=leave
POSTGRES_PASSWORD=leave_dev_password
POSTGRES_DB=leave_management
POSTGRES_PORT=5432

DATABASE_URL=postgresql://leave:leave_dev_password@localhost:5432/leave_management

# --- Organization backbone (Auth.js + Prisma) -------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Auth.js v5 reads AUTH_SECRET; NEXTAUTH_SECRET is accepted as an alias.
AUTH_SECRET=<random-strong-secret>
NEXTAUTH_SECRET=<random-strong-secret>

# CLI-only superadmin: npm run create-superadmin
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=super@admin.com
SUPERADMIN_PASSWORD=<strong-password>

# Seed: default Stacx organization + its admin (npm run seed)
STACX_ORG_NAME=Stacx
STACX_ADMIN_NAME=Stacx Admin
STACX_ADMIN_EMAIL=admin@stacx.com
STACX_ADMIN_PASSWORD=<strong-password>
