// Data model for the multi-tenant organization backbone.
//
// These models live in the `orgapp` Postgres schema, set by the `schema`
// parameter on the connection URL — see lib/prisma-url.ts. Prisma manages this
// schema and nothing else in the database.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  ADMIN
  MEMBER
}

/// Where a team member works from. Absent until an admin sets it.
enum WorkMode {
  WFO
  WFH
}

/// Whether a member is still on the team. Removal is a status change, not a
/// delete: leave and attendance rows will reference these users, and deleting
/// a person would take their history with them.
enum EmploymentStatus {
  ACTIVE
  INACTIVE
}

/// The base state of an attendance day. Exactly one applies.
enum AttendanceStatus {
  PRESENT
  WFH
  ABSENT
  LEAVE
}

/// An add-on to a day that was partly worked. Only ever set alongside PRESENT
/// or WFH, and only one at a time — enforced by the column shape plus a CHECK
/// constraint in the migration, not by application code alone.
enum AttendanceModifier {
  HALF_DAY
  SHORT_LEAVE
}

model Organization {
  id String @id @default(cuid())

  // Unique so the seed can upsert by name and re-run without duplicating.
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
  regions   Region[]

  attendance       Attendance[]
  attendanceEvents AttendanceEvent[]
}

/// An office/location a team is grouped by on the Team screen.
///
/// Scoped to one organization rather than global, so two organizations can each
/// have a "Chennai" without sharing a row.
model Region {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]
  createdAt      DateTime     @default(now())

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role

  // Null ONLY for SUPERADMIN; required for ADMIN and MEMBER. Enforced in
  // application logic (lib/rbac.ts) — the column itself has to stay nullable
  // to allow the SuperAdmin row.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Audit: who created this user. Null for CLI-created SuperAdmins.
  createdById String?
  createdAt   DateTime @default(now())

  // --- Team profile ---------------------------------------------------------
  //
  // Every field below is optional: they describe a MEMBER on the Team screen,
  // and a SUPERADMIN legitimately has none of them. `status` is the exception —
  // it always has an answer, so it defaults rather than being nullable.
  //
  // `initials` is deliberately absent: it is derived from `name` by
  // `initialsFor()` in lib/domain.ts, and a stored copy would drift on rename.

  title    String?
  empId    String?
  joinedOn DateTime?
  workMode WorkMode?
  status   EmploymentStatus @default(ACTIVE)

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  // The reporting line, as a reference rather than the fixture's name string,
  // so renaming a manager cannot orphan it. Validated to be inside the same
  // organization in lib/services.ts — the database cannot express that.
  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  // Two relations to Attendance, so both have to be named: the days that are
  // about this person, and the days this person recorded for someone else.
  attendance       Attendance[] @relation("AttendanceSubject")
  attendanceMarked Attendance[] @relation("AttendanceMarkedBy")

  phone          String?
  personalEmail  String?
  address        String?
  emergencyName  String?
  emergencyPhone String?

  // Employee ids are unique per organization, not globally. Postgres treats
  // NULLs as distinct, so members without one do not collide.
  @@unique([organizationId, empId])
  @@index([organizationId])
  @@index([regionId])
}

/// One member's attendance on one day.
///
/// The absence of a row is what "not marked yet" is stored as — there is no
/// UNMARKED status, so clearing a day is a delete and "how many are unmarked"
/// is roster size minus row count.
///
/// `organizationId` is denormalised from the member's own `User` row so the
/// screen's hottest query — every mark in one organization on one day — is a
/// single indexed read with no join. lib/attendance-service.ts always copies it
/// from the stored user, never from a request body.
model Attendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation("AttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Stored as DATE, not a timestamp: a day has no time and no offset.
  date DateTime @db.Date

  status   AttendanceStatus
  modifier AttendanceModifier?

  /// Who last wrote this row. The full history is in AttendanceEvent.
  ///
  /// Nullable, and SetNull rather than Restrict, because this is attribution
  /// rather than ownership: an admin who leaves is deleted, and neither
  /// blocking that delete nor destroying the team's attendance with it is
  /// acceptable. Null therefore means "the admin who marked this is gone", not
  /// "nobody marked it" — the service always sets it. AttendanceEvent.actorId
  /// keeps the original name either way, since it carries no foreign key.
  markedById String?
  markedBy   User?   @relation("AttendanceMarkedBy", fields: [markedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The natural key. Also the index behind every per-member read.
  @@unique([userId, date])
  @@index([organizationId, date])
}

/// Append-only log of every attendance write. Never updated, never deleted
/// except with its organization.
///
/// This is what makes unlimited backdating safe: a correction made three months
/// late is traceable rather than prevented.
///
/// `userId` and `actorId` are plain columns rather than relations on purpose —
/// an audit row has to outlive the rows it describes. `organizationId` keeps
/// its foreign key so the log is removed with the organization it belongs to.
model AttendanceEvent {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The member the mark is about.
  userId String
  date   DateTime @db.Date

  /// `from*` null means the day had no row; `to*` null means it was cleared.
  fromStatus   AttendanceStatus?
  fromModifier AttendanceModifier?
  toStatus     AttendanceStatus?
  toModifier   AttendanceModifier?

  /// The admin who made the change.
  actorId String
  at      DateTime @default(now())

  @@index([organizationId, date])
  @@index([userId, date])
}
